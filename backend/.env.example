# Gửi email (quên mật khẩu, xác minh email) qua Resend — https://resend.com (gói miễn phí).
# Để trống khi chạy thử: đường link sẽ được in ra cửa sổ backend thay vì gửi email.
# Cách 1 (khuyên dùng): gửi qua Gmail, tới được mọi địa chỉ, tối đa khoảng 500 email mỗi ngày
# Bật Xác minh 2 bước cho Gmail rồi tạo Mật khẩu ứng dụng tại https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASS=
# Chỉ cần khi không dùng Gmail
SMTP_HOST=
SMTP_PORT=465
# Hộp thư nhận tin nhắn từ trang Liên hệ (trống thì dùng SMTP_USER)
CONTACT_INBOX=
# Cách 2: Resend, địa chỉ onboarding@resend.dev chỉ gửi được tới email chủ tài khoản Resend
RESEND_API_KEY=
MAIL_FROM=sandwich beauty <onboarding@resend.dev>
# Địa chỉ công khai của máy chủ, dùng cho nút hủy nhận một chạm trong email bản tin (mặc định http://localhost:PORT)
PUBLIC_API_URL=
# Nghỉ giữa hai email bản tin (ms), Resend gói miễn phí cho tối đa 2 email mỗi giây
NEWSLETTER_SEND_GAP_MS=600
FRONTEND_URL=http://localhost:5173

# Giữ hàng cho đơn thanh toán online: quá hạn chưa trả tiền thì tự hủy và hoàn kho.
PAYMENT_HOLD_MINUTES=15
BANK_TRANSFER_HOLD_HOURS=24
STOCK_RESERVATION_SWEEPER=true
